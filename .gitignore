node_modules/
dist/
coverage/
*.tsbuildinfo

# Env — never commit secrets. .env.example is the template and IS tracked.
.env
.env.*
!.env.example

.vercel/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# --- ruflo / claude-flow ---
# Local agent tooling state: SQLite memory and vector stores, logs, session
# history, and machine-specific hook overrides (the generated settings.json
# carries Windows-only paths). All regenerated by `npx ruflo@latest init`, and
# none of it is meaningful to anyone else cloning the repo.
# Paths are anchored with a leading slash so they only match the repo root and
# never a directory inside client/ or server/.
/.claude/
/.claude-flow/
/.swarm/
/.hive-mind/
/.agentdb/
/coordination/
/memory/
/ruvector.db
# SQLite write-ahead-log sidecars, which change on every read.
*.db-shm
*.db-wal

# shared/ is types-only; any emitted JS here is a stale build artifact.
/shared/*.js
/shared/*.js.map
.neon
