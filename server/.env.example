# Copy to server/.env for local development. Never commit the real .env.
# In production these are set in the Vercel dashboard, not in a file.

NODE_ENV=development
PORT=3000

# Local Docker Postgres (docker compose up -d). Host port is 5433 to avoid
# colliding with any other Postgres already on 5432.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio
DATABASE_SSL=false

# Signs admin session JWTs and salts stored IP hashes.
# Production MUST be >= 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=local-development-secret-at-least-32-characters-long

# Only needed when the API is on a different origin than the site (Render
# fallback). Leave unset on Vercel, where the function is same-origin.
# CORS_ORIGIN=https://bryanchua.com

# --- Optional. Each feature degrades gracefully when its key is absent. ---

# Read-only PAT (no scopes needed for public repos). Lifts the GitHub API rate
# limit from 60/hr to 5000/hr. Without it, live repo stats still work, just with
# a tighter ceiling.
# GITHUB_TOKEN=
GITHUB_CACHE_TTL_MINUTES=360

# Contact form notification email. Without these the message is still stored in
# the database and readable at /admin — you just don't get an email about it.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=bcbryanchua@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_RATE_LIMIT=3

# Admin account created by `npm run db:seed`. Min 12 characters.
SEED_ADMIN_EMAIL=bcbryanchua@gmail.com
# SEED_ADMIN_PASSWORD=
