{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "legacy/**",
    "docs/**",
    "**/coverage/**"
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "server/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
